# alert text rewritten for funky
alert-level-announcement = Security telemetry alert.
                           Station alert updated to {$name}.
                           {$announcement}

# unknown name uses generic-unknown-title
alert-level-unknown-announcement = This is a test of the alert broadcast system.
alert-level-unknown-instructions = Unknown.

alert-level-green = Green
alert-level-green-announcement = Threat parameters returned to baseline.
                                 Personnel are to resume standard operational duties.
alert-level-green-instructions = Do your job.

## FUNKY - newlines have been added to most of the alert levels (mainly for PA announcement formatting)
alert-level-blue = Blue
alert-level-blue-announcement = Hostile threat presence confirmed.
                                Security personnel are authorized to perform random searches of personnel and belongings.
                                Station personnel are to report any irregularities to Security personnel.
alert-level-blue-instructions = Crewmembers are advised to be vigilant and report suspicious activity to security.

alert-level-red = Red
alert-level-red-announcement = Critical threat to station integrity confirmed.
                               Security personnel are authorized to use lethal force.
                               Non-essential personnel are to shelter in place and yield to orders given by present authorities.
alert-level-red-instructions = Crewmembers should find a safe place to shelter in, and are advised to follow any present authorities.

alert-level-violet = Violet
alert-level-violet-announcement = Active biological pathogen confirmed within the station.
                                  Medical personnel are authorized to enforce strict quarantine of symptomatic subjects.
                                  Personnel are to maintain physical distancing and observe biohazard containment protocols.
alert-level-violet-instructions = Crewmembers are advised to distance themselves from others and perform safety measures to prevent further spread.

alert-level-yellow = Yellow
alert-level-yellow-announcement = Significant structural or atmospheric integrity failure confirmed within the station.
                                  Engineering personnel dispatch required for emergency repairs.
                                  Non-engineering personnel are to remain clear from affected areas and prepare for potential depressurization.
alert-level-yellow-instructions = Crewmembers are advised to stay away from the threat, and stay in their workplaces if necessary.

alert-level-gamma = Gamma
alert-level-gamma-announcement = Central Command executive directive verified.
                                 Security personnel are to remain armed at all times.
                                 All personnel are to muster within public areas and await further instructions.
alert-level-gamma-instructions = All civilians are to immediately seek their nearest head for transportation to a secure location.

# funky - the first sentence of this announcement, in combination with the beginning of the announcement,
# is the perfect length to get chopped off in a chat bubble, so i've left it as is as a compromise
alert-level-delta = Delta
alert-level-delta-nuke-announcement = Emergency scuttle protocol engaged.
                                      Catastrophic damage to station is imminent.
                                      Abandon station. Proceed to emergency evacuation vessel or escape pods immediately.
alert-level-delta-instructions = Crewmembers are advised to listen to heads of staff for more information.

alert-level-epsilon = Epsilon
