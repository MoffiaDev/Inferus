cmd-crewlet-desc = Creates a crewlet of a player that follows its owner around.
cmd-crewlet-help = Usage: crewlet <Username|EntityUid> [owner Username|EntityUid]
cmd-crewlet-arg-template = <template>
cmd-crewlet-arg-owner = [owner]
cmd-crewlet-not-found = Can't find username/uid: {$target}
cmd-crewlet-no-entity = {$target} does not have an entity.
cmd-crewlet-failed = Could not make a crewlet of {$target}.
cmd-crewlet-success = Created {$crewlet}.
